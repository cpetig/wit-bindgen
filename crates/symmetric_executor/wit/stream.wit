// language neutral stream implementation
interface symmetric-stream {
    use symmetric-executor.{event-subscription};

    resource address;
    // special zero allocation/copy data type (caller provided buffer)
    resource buffer {
        constructor(addr: address, capacity: u64);
        get-address: func () -> address;
        get-size: func() -> u64;
        set-size: func(size: u64);
        capacity: func() -> u64;
    }

    enum stream-state {
        eof,
        pending,
    }

    resource stream-obj {
        constructor();
        // create a new instance e.g. for reading or tasks
        // (Assumption: This is never used to duplicate the writing side)
        clone: func(writing: bool) -> stream-obj;

        // reading (in roughly chronological order)
        /// indicates EOF
        is-write-closed: func() -> bool;
        start-reading: func(buffer: buffer) -> result<_, buffer>;
        read-ready-subscribe: func() -> event-subscription;
        // close the reading side, returning any in-flight buffer(s)
        close-read: func() -> list<buffer>;
        read-result: func() -> result<buffer, stream-state>;

        // writing
        is-read-closed: func() -> bool;
        start-writing: func() -> result<buffer, stream-state>;
        write-ready-subscribe: func() -> event-subscription;
        finish-writing: func(buffer: buffer) -> result<_, buffer>;
    }
}
