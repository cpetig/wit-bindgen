// This interface will only work with symmetric ABI (shared everything),
// it can't be composed with the canonical ABI

/// Asynchronous executor functionality for symmetric ABI
interface symmetric-executor {
    // These pseudo-resources are just used to
    // pass pointers to register

    /// Return value of an event callback
    enum callback-state {
        /// Call the function again
        pending,
        /// The function has completed, all results are written, data is freed,
        /// calling the function again is not permitted as data became invalid!
        ready,
    }

    /// This wraps a user provided function of type
    /// `fn (callback-data) -> callback-state`
    resource callback-function;
    /// This wraps opaque user data, freed by the callback when
    /// it returns ready
    resource callback-data;

    /// The receiving side of an event
    resource event-subscription {
        /// Whether the event is active (used by poll implementation)
        ready: func() -> bool;
        /// Create a timeout event
        from-timeout: static func(nanoseconds: u64) -> event-subscription;
        /// Duplicate the subscription (e.g. for repeated callback registering, same cost as subscribe)
        dup: func() -> event-subscription;
        /// Reset subscription to be inactive, only next trigger will ready it
        reset: func();
    }
    /// A user controlled event
    resource event-generator {
        constructor();
        /// Get the receiving side (to pass to other parts of the program)
        /// Make sure to reset if you only need future events
        subscribe: func() -> event-subscription;
        /// Trigger all subscribers
        activate: func();
        /// Callee side: `cancel` gets activated when a caller cancels the task whose
        /// completion this generator signals (see cancel-task).
        link-cancel: func(cancel: borrow<event-generator>);
        /// Callee side: the task ended because of a cancellation, its results are
        /// not written. Activates the generator like `activate`.
        activate-cancelled: func();
    }

    /// Handle to cancel a callback registration. Dropping the handle keeps the
    /// registration (the callback is still called when the event triggers).
    resource callback-registration {
        /// Unregister the callback, it is never called again after this returns
        /// (from any thread).
        ///
        /// * `some(data)`: the callback was not running, the registration is
        ///   removed (its resources are released right away), the caller owns
        ///   `data` again. This is also the result if the callback was running
        ///   on another thread and returned `pending`: cancel waits for it.
        /// * `none`: the callback finished with `ready` (and freed `data`), also
        ///   when it is waited for on another thread, or the registration was
        ///   completed by `register` itself, or the callback is running on the
        ///   calling thread right now (cancel was called from inside the callback
        ///   or from a nested executor loop it runs): then it is not called again
        ///   after it returned, whatever it returns, and `data` stays with it.
        cancel: static func(obj: callback-registration) -> option<callback-data>;
        /// Whether the callback can still be called: it is registered and has
        /// neither returned `ready` nor been cancelled (true while it runs).
        is-pending: func() -> bool;
    }

    /// Return value of an async call, lowest bit encoding
    enum call-status {
        /// For symmetric this means that processing has started, parameters should still remain valid until null,
        /// params-read = non-null, results-written,done = null
        started,
        /// For symmetric: Retry the call (temporarily out of memory)
        not-started,
    }

    /// Wait until all registered events have completed
    run: func();
    /// Register a callback for an event
    register: func(trigger: event-subscription, callback: callback-function, data: callback-data) -> callback-registration;
    /// Register a callback for an event, skip if already active
    register-unique: func(trigger: event-subscription, callback: callback-function, data: callback-data) -> option<callback-registration>;
    /// Wait for a specific event
    block-on: func(trigger: event-subscription);
    /// Caller side: cancel the task behind `task` (the subscription returned by an
    /// async call). If it already completed, returns false right away. Otherwise the
    /// linked cancel generator (if any) is activated and the executor runs (like
    /// block-on) until the callee completes. Returns true if the callee ended with
    /// activate-cancelled (results not written), false if it completed normally
    /// (results written). Afterwards the callee no longer accesses arguments or
    /// results. A callee without link-cancel simply runs to completion.
    cancel-task: func(task: event-subscription) -> bool;
}
